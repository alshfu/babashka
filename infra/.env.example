# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.

# Порт сигналинга на хосте (перед ним обычно стоит nginx/Caddy с TLS: клиенты ходят по wss://).
SIGNALING_PORT=8080

# TURN. Общий статический секрет сигналинга и coturn — из него выводятся эфемерные креды.
# Сгенерировать:  openssl rand -base64 32
TURN_SECRET=замените-обязательно
TURN_HOST=turn.example.org:3478
TURN_REALM=pult.local
TURN_TTL=43200

# Реальный внешний IP машины: без него coturn раздаёт нерабочие кандидаты.
TURN_EXTERNAL_IP=203.0.113.10

STUN_URLS=stun:stun.l.google.com:19302

# Журнал метаданных сессий. Содержимого помощи в нём нет и быть не может.
JOURNAL_RETENTION_DAYS=90

# Пробуждение спящего телефона бабушки. Пусто — push отключён, работает только онлайн-путь.
FCM_KEY=

LOG_LEVEL=info
