<?xml version="1.0" encoding="utf-8"?>
<!-- Указатель внука: спокойный зелёный круг с ореолом, живёт 3 секунды. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#3322C55E" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#22C55E" />
        </shape>
    </item>
</layer-list>
