<?xml version="1.0" encoding="utf-8"?>
<!--
  Единственный экран, который бабушка вообще нажимает.
  Требования (docs/android-grandma.md §1): кнопка «Разрешить» не меньше 30 % высоты,
  крупный шрифт, никаких обратных отсчётов на кнопке и никаких галочек по умолчанию.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        tools:text="Петя хочет помочь"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="22sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/allow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="220dp"
        android:text="@string/consent_allow"
        android:textSize="40sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/deny"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/consent_deny"
        android:textSize="22sp" />

</LinearLayout>
