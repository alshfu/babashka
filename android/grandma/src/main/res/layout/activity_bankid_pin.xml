<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bankid_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.BankIdPinActivity">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bankid_pin_title"
        android:textColor="@color/bankid_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/bankid_pin_message"
        android:textColor="@color/bankid_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:letterSpacing="0.3"
        android:text="• • • • • • • •"
        android:textColor="@color/bankid_text"
        android:textSize="32sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <Button
            android:id="@+id/key_1"
            style="@style/BankIdKey"
            android:text="1" />

        <Button
            android:id="@+id/key_2"
            style="@style/BankIdKey"
            android:text="2" />

        <Button
            android:id="@+id/key_3"
            style="@style/BankIdKey"
            android:text="3" />

        <Button
            android:id="@+id/key_4"
            style="@style/BankIdKey"
            android:text="4" />

        <Button
            android:id="@+id/key_5"
            style="@style/BankIdKey"
            android:text="5" />

        <Button
            android:id="@+id/key_6"
            style="@style/BankIdKey"
            android:text="6" />

        <Button
            android:id="@+id/key_7"
            style="@style/BankIdKey"
            android:text="7" />

        <Button
            android:id="@+id/key_8"
            style="@style/BankIdKey"
            android:text="8" />

        <Button
            android:id="@+id/key_9"
            style="@style/BankIdKey"
            android:text="9" />

        <Button
            android:id="@+id/key_clear"
            style="@style/BankIdKey"
            android:text="@string/bankid_pin_clear"
            android:textSize="14sp" />

        <Button
            android:id="@+id/key_0"
            style="@style/BankIdKey"
            android:text="0" />

        <Button
            android:id="@+id/key_ok"
            style="@style/BankIdKey"
            android:text="@string/bankid_pin_ok"
            android:textSize="14sp" />
    </GridLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5" />
</LinearLayout>
