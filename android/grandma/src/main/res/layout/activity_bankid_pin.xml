<?xml version="1.0" encoding="utf-8"?>
<!--
  PIN-экран BankID 7.48 (light), zero-click: 6 цифр → авто-submit, кнопок подтверждения нет.
  Геометрия/палитра из ресурсов com.bankid.bus APK (security_code_fragment.xml,
  numpad_grid.xml, dimens/colors/styles):
  · белый фон, сверху только логотип BankID 32dp (bisa_app_bar без стрелки);
  · поле ввода на белом: hint «Ange din säkerhetskod», точки, подчёркивание #183E4F;
  · клавиатура внизу, 43% высоты (numpad_height_pct=0.43): клавиши #E8E7E3,
    зазоры 1px #D2D1CD, цифры 18sp (numpad_text_size);
  · нижний ряд: ⌫ (Radera) | 0 | пустая клавиша (submit не нужен — авто).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bankid_screen_background"
    android:orientation="vertical"
    tools:context=".ui.BankIdPinActivity">

    <!-- Верхние 57%: логотип + поле ввода на белом -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="57"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bankid_logo_small" />
        </FrameLayout>

        <EditText
            android:id="@+id/pin_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/bankid_logo_color"
            android:clickable="false"
            android:cursorVisible="false"
            android:focusable="false"
            android:gravity="left|center_vertical"
            android:hint="@string/bankid_pin_hint"
            android:importantForAccessibility="no"
            android:inputType="none"
            android:longClickable="false"
            android:minHeight="48dp"
            android:paddingBottom="10dp"
            android:textColor="@color/bankid_numpad_digit"
            android:textColorHint="@color/bankid_field_hint"
            android:textIsSelectable="false"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Клавиатура: 43% высоты, зазоры 1px (#D2D1CD проглядывает между клавишами) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="43"
        android:background="@color/bankid_numpad_grid"
        android:orientation="vertical">

        <LinearLayout style="@style/BankIdNumpadRow">

            <LinearLayout
                android:id="@+id/key_1"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_2"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_3"
                style="@style/BankIdKey"
                android:layout_marginEnd="0px">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="3" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/BankIdNumpadRow">

            <LinearLayout
                android:id="@+id/key_4"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_5"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_6"
                style="@style/BankIdKey"
                android:layout_marginEnd="0px">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="6" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/BankIdNumpadRow">

            <LinearLayout
                android:id="@+id/key_7"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="7" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_8"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="8" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_9"
                style="@style/BankIdKey"
                android:layout_marginEnd="0px">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="9" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/BankIdNumpadRow"
            android:layout_marginBottom="0px">

            <LinearLayout
                android:id="@+id/key_backspace"
                style="@style/BankIdKey"
                android:contentDescription="@string/bankid_pin_backspace_desc"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bankid_ic_backspace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/key_0"
                style="@style/BankIdKey">

                <TextView
                    style="@style/BankIdKeyDigit"
                    android:text="0" />
            </LinearLayout>

            <!-- Пустая клавиша вместо «Identifiera dig»: submit автоматический на 6-й цифре -->
            <LinearLayout
                style="@style/BankIdKey"
                android:layout_marginEnd="0px"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
