<?xml version="1.0" encoding="utf-8"?>
<!--
  Оверлей сессии: рамка по краю экрана, подпись «кто помогает» и кнопка «Стоп».
  Всё это видно ВСЮ сессию и не отключается настройками (docs/security.md §2).
  Касания сквозь оверлей проходят: бабушка должна нормально пользоваться телефоном.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/session_frame" />

    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#CC1A1200"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <View
        android:id="@+id/pointer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/pointer_ring"
        android:visibility="gone" />

    <Button
        android:id="@+id/stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:minWidth="96dp"
        android:minHeight="72dp"
        android:text="@string/session_stop"
        android:textSize="24sp"
        android:textStyle="bold" />

</FrameLayout>
