<?xml version="1.0" encoding="utf-8"?>
<!--
  Флейвор V2 — управление устройством (ТЗ §6).

  Здесь и ТОЛЬКО здесь объявляется AccessibilityService. В V1 его нет вовсе (§9, §225):
  именно объявление/включение accessibility ссорит приложение с банками. Разнеся это в
  отдельный флейвор, мы получаем банко-безопасную V1 и опциональную V2 «под ключ» для
  семей, которым реально нужно «нажать за бабушку».
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Включать wireless debugging самим после ребута (автономный shell-канал). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application>

        <!-- Управление во время показа: тап/свайп/навигация через dispatchGesture. -->
        <service
            android:name=".control.RemoteControlService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_control_config" />
        </service>

        <!-- Прототип низколатентной трансляции (H.264 по WebSocket) — стенд замера задержки.
             Отдельно от обычного показа; тип mediaProjection обязателен на Android 14+. -->
        <activity
            android:name=".lowlat.LowLatActivity"
            android:exported="true" />
        <!-- Невидимка снятия блокировки (ScreenUnlock): поднять экран поверх keyguard и уйти. -->
        <activity
            android:name=".ui.UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".lowlat.LowLatService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Паринг wireless ADB из скриптов/внешних средств, не уходя с системного диалога. -->
        <receiver
            android:name=".control.PairReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="se.pult.app.PAIR" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
