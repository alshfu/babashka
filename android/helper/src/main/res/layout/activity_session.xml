<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран сессии. Внук видит экран бабушки и ведёт по нему указателем.
  Кнопок «сделать за неё» здесь нет: управление — отдельный модуль V2 (docs/roadmap.md).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <!-- Экран бабушки. Пропорции сохраняются: иначе указатель попадёт не туда. -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/redacted"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/redacted"
            android:textColor="#AAAAAA"
            android:textSize="20sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/sayTap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/say_tap" />

        <Button
            android:id="@+id/sayScroll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/say_scroll" />

        <Button
            android:id="@+id/finish"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/finish" />
    </LinearLayout>
</LinearLayout>
