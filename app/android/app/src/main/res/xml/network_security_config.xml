<?xml version="1.0" encoding="utf-8"?>
<!-- Локальный сервер разработки ходит по ws:// (cleartext) — только для
     loopback-доменов, остальной трафик остаётся под дефолтной политикой. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Эмулятор видит хост-машину как 10.0.2.2 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Локальный хаб на LAN (рабочая машина) -->
        <domain includeSubdomains="false">192.168.3.100</domain>
    </domain-config>
</network-security-config>
